{
  "name": "decide-engine-tools",
  "version": "1.0.0",
  "description": "ViaDecide Studio — 37 decision-making, productivity and game tools",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "automation/*"
  ],
  "scripts": {
    "test": "node tests/run-all.js",
    "test:unit": "node tests/unit/run.js",
    "test:smoke": "node tests/smoke/run.js",
    "version:bump": "node tests/scripts/bump-version.js",
    "manifest:sync": "node automation/metadata/manifest-sync.js",
    "scaffold": "node automation/scaffolding/scaffold-tool.js",
    "verify:gate": "node automation/workflows/pre-commit-check.js"
  },
  "devDependencies": {
    "jsdom": "^29.0.1",
    "playwright": "^1.44.0"
  },
  "engines": {
    "node": ">=18"
  }
}
