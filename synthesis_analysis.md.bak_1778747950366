// tools/pomodoro-timer/tool.js
import { ToolStorage } from "../../../shared/tool-storage";

class PomodoroTimer {
  constructor() {
    this.workTime = 25;
    this.breakTime = 5;
    this.currentSession = 0;
    this.totalSessions = 0;
    this.timerInterval = null;

    this.init();
  }

  init() {
    const config = JSON.parse(localStorage.getItem("pomodoro-timer-config"));
    if (config) {
      this.workTime = config.work_time;
      this.breakTime = config.break_time;
    }
  }

  startTimer() {
    this.timerInterval = setInterval(() => {
      this.currentSession++;
      document.getElementById("timer").innerHTML = `Work Time: ${this.workTime} minutes, Break Time: ${this.breakTime} minutes, Session: ${this.currentSession}`;
      if (this.currentSession >= this.totalSessions) {
        clearInterval(this.timerInterval);
      }
    }, 1000);
  }

  stopTimer() {
    clearInterval(this.timerInterval);
  }

  saveConfig() {
    localStorage.setItem("pomodoro-timer-config", JSON.stringify({ work_time: this.workTime, break_time: this.breakTime }));
  }

  loadConfig() {
    const config = localStorage.getItem("pomodoro-timer-config");
    if (config) {
      this.workTime = JSON.parse(config).work_time;
      this.breakTime = JSON.parse(config).break_time;
    }
  }
}

const tool = new PomodoroTimer();
document.addEventListener("DOMContentLoaded", () => {
  const startButton = document.createElement("button");
  startButton.textContent = "Start";
  startButton.onclick = () => {
    tool.startTimer();
  };
  const stopButton = document.createElement("button");
  stopButton.textContent = "Stop";
  stopButton.onclick = () => {
    tool.stopTimer();
  };
  const saveButton = document.createElement("button");
  saveButton.textContent = "Save Config";
  saveButton.onclick = () => {
    tool.saveConfig();
  };
  const loadButton = document.createElement("button");
  loadButton.textContent = "Load Config";
  loadButton.onclick = () => {
    tool.loadConfig();
  };

  document.body.appendChild(startButton);
  document.body.appendChild(stopButton);
  document.body.appendChild(saveButton);
  document.body.appendChild(loadButton);

  tool.startTimer();
});

