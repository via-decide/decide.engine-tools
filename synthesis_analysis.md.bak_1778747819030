const ToolStorage = require('../shared/tool-storage');
const fs = require('fs');

class FlashcardEngine {
  constructor() {
    this.deckFile = null;
    this.flashcards = [];
    this.stats = {};
  }

  async startFlashcards(event) {
    const deckFile = event.target.deckFile.files[0];
    if (!deckFile) return;

    try {
      const deckData = await fs.promises.readFile(deckFile.path, 'utf8');
      this.flashcards = JSON.parse(deckData);
      ToolStorage.set('flashcard-engine', this.stats);

      // render flashcards
      const flashcardHTML = this.flashcards.map((fc) => `
        <div class="flashcard">
          <h2>${fc.front}</h2>
          <p>${fc.back}</p>
        </div>
      `).join('');
      document.getElementById('flashcard-container').innerHTML = flashcardHTML;
    } catch (err) {
      console.error(err);
    }
  }

