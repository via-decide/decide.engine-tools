{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "browser": true,
    "es2022": true
  },
  "rules": {
    "no-restricted-imports": ["error", {
      "patterns": [{
        "group": ["../../apps/*", "../../../apps/*", "apps/*"],
        "message": "Apps cannot cross-import from other apps. Use shared packages in @via/packages/* instead."
      }]
    }]
  }
}
